{
  "name": "uncrowned-music",
  "productName": "Uncrowned Music",
  "version": "1.0.0",
  "description": "Uncrowned Music para PC",
  "main": "main.js",
  "author": "Vinicius Andrade",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "music-metadata": "7.14.0",
    "@ghostery/adblocker-electron": "2.18.2"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.uncrowned.music.desktop",
    "productName": "Uncrowned Music",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "yt-preload.js",
      "renderer/**",
      "build/icon.png",
      "build/icon.ico"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Uncrowned Music",
      "artifactName": "UncrownedMusic-Setup.exe",
      "installerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "UncrownedMusic-Portable.exe"
    }
  }
}